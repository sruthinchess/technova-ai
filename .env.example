# Copy to .env and fill in what you need. Everything here is optional.
PORT=3000
DB_PATH=./data/db.json

# Live model answers. Leave empty to run on the built-in skills only.
NVIDIA_API_KEY=
MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
MODEL_FAST=meta/llama-3.1-8b-instruct
MODEL_PRO=meta/llama-3.3-70b-instruct

# Set to 1 when serving over HTTPS so cookies are marked Secure.
SECURE_COOKIES=

# Web search for the assistant (optional). Either a Tavily key...
TAVILY_API_KEY=
# ...or a SearxNG instance that returns JSON.
SEARCH_URL=
SEARCH_API_KEY=

# Dev only: let the page reader reach localhost (tests use it).
ALLOW_LOCAL_FETCH=

# Browser tool: point this at a Chrome/Chromium binary if it isn't in a usual place.
# Requires `npm i playwright-core` (optional dependency).
BROWSER_PATH=
